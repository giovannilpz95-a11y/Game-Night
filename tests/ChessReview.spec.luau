local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Chess = require(ReplicatedStorage.Shared.Games.Chess)
local ChessReview = require(ReplicatedStorage.Shared.ChessReview)

return function(T)
	local function game(moves: { { string } })
		local s = Chess.new(2)
		for i, mv in moves do
			local seat = if i % 2 == 1 then 1 else 2
			local move = { from = mv[1], to = mv[2], promotion = mv[3] }
			assert(Chess.validateMove(s, seat, move), `{mv[1]}-{mv[2]}`)
			Chess.applyMove(s, seat, move)
		end
		return Chess.getView(s, 1)
	end

	T.test("opening names come from the longest book line", function()
		T.eq((ChessReview.opening({ "e4", "e5", "Nf3", "Nc6", "Bb5" })), "Ruy Lopez")
		T.eq((ChessReview.opening({ "e4", "c5" })), "Sicilian Defense")
		T.eq((ChessReview.opening({ "d4", "d5", "c4", "e6" })), "Queen's Gambit Declined")
		local name, book = ChessReview.opening({ "e4", "e5", "Ke2" })
		T.eq(name, "Open Game")
		T.eq(book, 2, "Ke2 leaves the book")
		T.eq((ChessReview.opening({ "a3" })), nil)
	end)

	T.test("winning chances and accuracy follow the Lichess curves", function()
		T.eq(math.floor(ChessReview.winPercent(0) + 0.5), 50)
		T.ok(ChessReview.winPercent(300) > 70, "+3 is clearly winning")
		T.ok(ChessReview.winPercent(-Chess.MATE) < 1, "mated is lost")
		T.ok(ChessReview.moveAccuracy(60, 60) > 99, "no drop is ~100%")
		T.ok(ChessReview.moveAccuracy(80, 20) < 10, "a big drop is near 0")
		T.eq(ChessReview.classify(0.5, false), "Blunder")
		T.eq(ChessReview.classify(0.01, false), "Excellent")
		T.eq(ChessReview.classify(0.3, true), "Best")
	end)

	T.test("scholar's mate: the defender's blunder and the mate are found", function()
		local view = game({ { "e2", "e4" }, { "e7", "e5" }, { "f1", "c4" }, { "b8", "c6" }, { "d1", "h5" }, { "g8", "f6" }, { "h5", "f7" } })
		local review = ChessReview.run(view.startFen, view.past, { depth = 3, seconds = 0.2 })
		T.ok(review.done)
		T.eq(#review.moves, 7)
		T.eq(review.moves[1].label, "Book")
		T.eq(review.moves[6].san, "Nf6")
		T.eq(review.moves[6].label, "Blunder", "Nf6 allows mate")
		T.ok(review.moves[6].bestSan ~= nil, "a better move is named")
		T.eq(review.moves[7].label, "Best", "Qxf7# is best")
		T.eq(review.moves[7].san, "Qxf7#")
		T.ok(review.accuracy[1] > review.accuracy[2], "White played better")
		T.eq(review.counts[2].Blunder, 1)
		T.ok(string.find(ChessReview.describe(review.moves[6]), "blunder") ~= nil)
	end)

	T.test("promotions are matched to the piece that was chosen", function()
		local s = Chess.new(2, { fen = "8/P6k/8/8/8/8/8/K7 w - - 0 1" })
		Chess.applyMove(s, 1, { from = "a7", to = "a8", promotion = "n" })
		local view = Chess.getView(s, 1)
		local review = ChessReview.run(view.startFen, view.past, { depth = 2, seconds = 0.1 })
		T.eq(review.moves[1].san, "a8=N")
		T.ok(review.moves[1].label ~= "Best", "underpromoting here isn't best")
		T.eq(review.moves[1].bestSan, "a8=Q")
	end)

	T.test("step reviews one move at a time and empty games finish", function()
		local view = game({ { "e2", "e4" }, { "e7", "e5" } })
		local review = ChessReview.new(view.startFen, view.past, { depth = 2, seconds = 0.05 })
		T.eq(review:step(), false)
		T.eq(review.progress, 1)
		T.eq(review:step(), true)
		local empty = ChessReview.run(Chess.START_FEN, {}, { depth = 1, seconds = 0.01 })
		T.ok(empty.done)
		T.eq(empty.accuracy[1], 100)
	end)
end
