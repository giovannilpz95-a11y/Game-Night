-- The Word Tiles word list, built into a WordTrie the first time it's needed (about half a
-- second). The words live in server/Data/WordList, generated by tools/build-word-list.mjs
-- from the public-domain ENABLE list with offensive words removed. Server only: clients
-- never download it.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local WordTrie = require(ReplicatedStorage.Shared.WordTrie)

local Dictionary = {}

local trie: WordTrie.Trie? = nil

function Dictionary.get(): WordTrie.Trie
	if not trie then
		trie = WordTrie.fromEncoded(require(script.Parent.Parent.Data.WordList) :: any)
	end
	return trie :: WordTrie.Trie
end

return Dictionary
